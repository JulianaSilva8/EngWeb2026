extends layout

block content
  .w3-card-4 <!-- div -->
    header.w3-container.w3-teal
      h1 Filmes
        a.w3-btn.w3-right.w3-round.w3-light-gray(style="margin-left: 10px; height: 45px; font-size: 20px;" href="/atores") Atores
        a.w3-btn.w3-right.w3-round.w3-light-gray(style="margin-left: 10px; height: 45px; font-size: 20px;" href="/generos") Géneros

    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th Id
          th Título
          th Ano
          th Nr Géneros
          th Nr Atores
        each t in list
          tr(onclick=`window.location='/filmes/${t.id}'` style='cursor:pointer' onmouseover="this.style.backgroundColor='#5cb99d';" onmouseout="this.style.backgroundColor='';")
            td= t.id
            td= t.title
            td= t.year
            td= t.genres ? t.genres.length : 0
            td= t.cast ? t.cast.length : 0