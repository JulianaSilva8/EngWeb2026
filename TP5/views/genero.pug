extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Página do Género #{genero.nome}
    
    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th Filmes

        each f in genero.participacoes
          tr 
            td(onclick=`window.location='/filmes/${f.id}'` style='cursor:pointer'
                onmouseover="this.style.backgroundColor='#5cb99d';" onmouseout="this.style.backgroundColor='';")
                = f.title
      a.w3-button.w3-teal.w3-margin-top.w3-margin-bottom(href='/generos') Voltar