extends layout

block content
  .w3-card-4
    header.w3-container.w3-indigo
      h1 Página do Ator #{ator.nome}
    
    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th Filmes
        each f in ator.filmes
          tr
            td(onclick=`window.location='/filmes/${f.filme_id}'` style='cursor:pointer'
                onmouseover="this.style.backgroundColor='#5cb99d';" onmouseout="this.style.backgroundColor='';")
                = f.title
          
      a.w3-button.w3-indigo.w3-margin-top.w3-margin-bottom(href='/atores') Voltar