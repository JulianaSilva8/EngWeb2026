extends layout

block content
  .w3-card-4 <!-- div -->
    header.w3-container.w3-indigo
      h1 Géneros
        a.w3-btn.w3-right.w3-round.w3-light-gray(style="margin-left: 10px; height: 45px; font-size: 20px;" href="/filmes") Filmes
        a.w3-btn.w3-right.w3-round.w3-light-gray(style="margin-left: 10px; height: 45px; font-size: 20px;" href="/atores") Atores

    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th ID
          th Género 
          th Nr Filmes

        each t in list
            tr(onclick=`window.location='/generos/${t.id}'` style='cursor:pointer'
                onmouseover="this.style.backgroundColor='#5cb99d';" onmouseout="this.style.backgroundColor='';")
                td= t._id
                td= t.nome
                td= t.filmes ? t.filmes.length : 0