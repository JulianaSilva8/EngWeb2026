extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Exames Médicos Desportivos
        a.w3-margin-left.w3-btn.w3-round.w3-grey(href="/emd/registo") +
    .w3-container
      .w3-margin-top
        a.w3-button.w3-teal.w3-margin-right(href='/emd?sort=dataDesc') Ordenar por data (desc)
        a.w3-button.w3-teal.w3-margin-right(href='/emd?sort=nomeAsc') Ordenar por nome (asc)
        a.w3-button.w3-teal.w3-right(href='/emd/stats') Estatísticas

      table.w3-table-all.w3-margin-top
        tr
          th Nome
          th Data
          th Modalidade
          th Resultado 
          
        each t in list 
          tr(onclick=`window.location='/emd/${t.id}'` style='cursor: pointer;')
            td= t.primeiro_nome + " " + t.sobrenome
            td= t.data
            td= t.modalidade
            td= t.resultado ? '✅' : '❌'
            td
              a.w3-btn.w3-round.w3-blue-grey.w3-small(href=`/emd/editar/${t.id}`) Edit
              a.w3-btn.w3-round.w3-red.w3-small.w3-margin-left(href=`/emd/apagar/${t.id}`) Delete